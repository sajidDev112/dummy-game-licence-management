# Where the Opezee licence API lives.
VITE_LICENSE_API=http://192.168.0.186:5173/api

# Must match a product name in the dashboard exactly — a licence issued for
# another product will be refused.
VITE_PRODUCT_NAME=OpEzee Puzzle

# How often the running game re-checks the licence, in seconds.
# The production guidance is hourly (3600); 60 keeps the demo responsive so a
# deactivation in the dashboard shows up almost immediately.
VITE_SYNC_SECONDS=60
